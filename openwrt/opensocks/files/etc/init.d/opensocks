#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/tmp/opensocks/opensocks
PACKED=/usr/lib/opensocks/opensocks.gz
PIDFILE=/var/run/opensocks.pid

start_service() {
	mkdir -p /tmp/opensocks /etc/opensocks
	chmod 0700 /etc/opensocks
	if [ ! -s "$PACKED" ]; then
		local binary_url binary_sha256 actual_sha256
		binary_url="$(uci -q get opensocks.settings.binary_url)"
		binary_sha256="$(uci -q get opensocks.settings.binary_sha256)"
		[ -n "$binary_url" ] && [ ${#binary_sha256} -eq 64 ] || return 1
		case "$binary_sha256" in *[!0-9a-f]*) return 1;; esac
		rm -f /tmp/opensocks/opensocks.gz
		wget -O /tmp/opensocks/opensocks.gz "$binary_url" || return 1
		actual_sha256="$(sha256sum /tmp/opensocks/opensocks.gz | awk '{print $1}')"
		[ "$actual_sha256" = "$binary_sha256" ] || {
			rm -f /tmp/opensocks/opensocks.gz
			return 1
		}
		gzip -t /tmp/opensocks/opensocks.gz || return 1
		PACKED=/tmp/opensocks/opensocks.gz
	fi
	rm -f "$PROG"
	gzip -dc "$PACKED" > "$PROG" || return 1
	chmod 0755 "$PROG"
    procd_open_instance
    procd_set_param command "$PROG" --daemon
    procd_set_param env GOMEMLIMIT=24MiB GOGC=50
    procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
    procd_set_param file /etc/config/opensocks
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    procd_kill "$PROG" 2>/dev/null
}

reload_service() {
    restart
}
