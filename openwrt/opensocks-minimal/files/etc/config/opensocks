config settings 'settings'
	option mode 'smart'
	option tun '0'
	option free_only '1'
	option auto_connect '1'
	option auto_route '1'
	option region ''
	option api_domain 'https://abscf2.fobwifi.com'
	option engine_binary '/usr/bin/ss-redir'
	option binary_url 'https://github.com/NarYuki/OpenSocks/releases/download/v0.2.0/opensocks-linux-mipsle.gz'
	option binary_sha256 '@BINARY_SHA256@'
