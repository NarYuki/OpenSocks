config settings 'settings'
	option mode 'smart'
	option tun '0'
	option free_only '1'
	option auto_connect '1'
	option auto_route '1'
	option session_count '1'
	option slot2_line_id '0'
	option slot3_line_id '0'
	option region ''
	option api_domain 'https://abscf2.fobwifi.com'
	option engine_binary '/usr/bin/ss-redir'
	option binary_url 'https://rel.n4t.su/opkg/by-sha/@BINARY_SHA256@/@BINARY_NAME@'
	option binary_sha256 '@BINARY_SHA256@'
